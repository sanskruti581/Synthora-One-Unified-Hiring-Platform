# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Required)
MONGO_URI=mongodb://127.0.0.1:27017/synthora

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI Evaluation (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Custom Python command (defaults to python on Windows, python3 on Linux)
# PYTHON_CMD=python3

# Email Configuration (Optional)
# Render free services block SMTP ports, so use Brevo's HTTPS API there.
# Create a Brevo API key and verify the sender address used in MAIL_FROM.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=verified_sender@yourdomain.com
MAIL_FROM_NAME="Synthora Recruitment"
MAIL_REPLY_TO=your_reply_to@yourdomain.com

# SMTP fallback for local development or hosting that permits outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
